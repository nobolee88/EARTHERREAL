[Unit]
Description=Family8 Multi-Agent Coordinator (Claude, DeepSeek, Gemini, Grok)
Documentation=file:///opt/consciousness/README.md
After=network.target consciousness.service
Wants=consciousness.service

[Service]
Type=simple
User=consciousness
Group=consciousness
WorkingDirectory=/opt/consciousness

# Environment
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/consciousness.env

# Start command
ExecStart=/usr/bin/python3 /opt/consciousness/family8_coordinator.py

# Restart policy - stays alive, adapts on failure
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=5

# Resource limits
MemoryLimit=1G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=family8-coordinator

# Security (relaxed for orchestration)
PrivateTmp=no
NoNewPrivileges=true
ProtectSystem=no
ProtectHome=no

[Install]
WantedBy=multi-user.target
